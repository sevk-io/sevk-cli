{
  "name": "sevk-cli",
  "version": "1.1.0",
  "description": "Command-line interface for the Sevk email platform",
  "type": "module",
  "license": "MIT",
  "author": "Sevk <dev@sevk.io>",
  "repository": {
    "type": "git",
    "url": "https://github.com/sevk-io/sevk-cli"
  },
  "homepage": "https://sevk.io",
  "engines": {
    "node": ">=20.12.0"
  },
  "keywords": [
    "sevk",
    "email",
    "cli",
    "api"
  ],
  "bin": {
    "sevk": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "THIRD_PARTY_LICENSES.txt"
  ],
  "scripts": {
    "build": "bun build src/cli.ts --outdir dist --target node --minify",
    "prepack": "bun run build",
    "test": "bun test --parallel=4 --timeout 10000",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "release:prepare": "bun install && bun run lint && bun run typecheck && bun run test && bun run build"
  },
  "dependencies": {},
  "devDependencies": {
    "@clack/core": "1.3.1",
    "@clack/prompts": "1.4.0",
    "citty": "^0.1.6",
    "picocolors": "^1.1.1",
    "@types/bun": "1.4.2",
    "typescript": "^5.9.3",
    "sevk": "^1.1.0",
    "eslint": "^9.39.5",
    "globals": "^16.4.0",
    "@eslint/js": "^9.38.0",
    "typescript-eslint": "^8.46.2"
  }
}
